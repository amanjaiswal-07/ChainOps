# Copy to .env and fill in. Never commit .env.

# --- LLM -------------------------------------------------------------------
# auto: live if OPENROUTER_API_KEY is set, otherwise offline (rule-based agents)
# live: always call the LLM (fails fast with a clear message if no key)
# offline: never call the LLM
LLM_MODE=auto
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# Optional LangSmith tracing
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=chainops

# --- Database ----------------------------------------------------------------
# Default: data/supply_chain.db inside the repo (created and seeded on first run)
# DATABASE_URL=sqlite:///C:/path/to/supply_chain.db

# --- Agent rules ---------------------------------------------------------------
SUPPLIER_RELIABILITY_THRESHOLD=0.90
LOGISTICS_MAX_ETA_DAYS=7
NEAR_REORDER_FACTOR=1.2

# --- Validation ----------------------------------------------------------------
STALE_PO_DAYS=30
EVENT_MAX_AGE_HOURS=24
EVENT_FUTURE_SKEW_MINUTES=5

# --- Event triggers ------------------------------------------------------------
DEMAND_SPIKE_THRESHOLD=1.25
SHIPMENT_DELAY_THRESHOLD_DAYS=2

# --- Governance ----------------------------------------------------------------
MAX_ORDER_QUANTITY=1000
APPROVAL_QUANTITY_THRESHOLD=300

# --- API -------------------------------------------------------------------------
MAX_REQUEST_BYTES=16384
LOG_LEVEL=INFO
